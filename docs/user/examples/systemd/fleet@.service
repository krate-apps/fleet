[Unit]
Description=Fleet BitTorrent web UI (%i)
After=network.target
# Optional: wait for the user's rTorrent if it is also systemd-managed.
# After=rtorrent@%i.service

[Service]
Type=simple
User=%i
Group=%i
ExecStart=/opt/%i/fleet/current/fleet -config /home/%i/.config/fleet/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Optional: inject the AES master key (base64 of 32 raw bytes) via systemd credentials.
# Fleet reads $CREDENTIALS_DIRECTORY/fleet-secrets.key before data_dir/.fleet-secrets.key.
#   LoadCredential=fleet-secrets.key:/home/%i/.config/fleet/fleet-secrets.key
# SQLite / cache / config writes. Include download_roots parents (Files move/copy,
# erase_data, mktorrent) — ProtectHome=read-only blocks other $HOME paths.
ReadWritePaths=/home/%i/.local/share/fleet /home/%i/.cache/fleet /home/%i/.config/fleet /home/%i/medias
WorkingDirectory=/opt/%i/fleet/current

[Install]
WantedBy=multi-user.target
