{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/docs/developer/schemas/theme.schema.json",
  "title": "Fleet theme package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "colorScheme", "css"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "description": "Stable theme id, e.g. org.fleet.theme.slate"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 280 },
    "version": { "type": "string", "minLength": 1 },
    "colorScheme": { "type": "string", "enum": ["dark", "light"] },
    "css": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to CSS (typically theme.css) with :root[data-fleet-theme=…] tokens"
    },
    "uiThemeId": {
      "type": "string",
      "description": "Short id for data-fleet-theme attribute; defaults to last segment of id"
    }
  }
}
