{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/docs/developer/schemas/bucket-app.schema.json",
  "title": "Fleet bucket app listing (bucket/*.json)",
  "description": "JSON listing for an extension or theme. Filename is the package key; id inside the file is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "id", "name", "version"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "type": "string", "enum": ["extension", "theme"] },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "maxLength": 280,
      "description": "Short human-readable summary for catalog UI"
    },
    "version": { "type": "string", "minLength": 1 },
    "api": {
      "type": "string",
      "minLength": 1,
      "description": "Required when kind is extension (semver range for Fleet SDK)"
    },
    "homepage": { "type": "string" },
    "license": { "type": "string" },
    "architecture": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "hash": {
            "type": "string",
            "description": "sha256:<hex> or bare 64-char hex"
          }
        }
      }
    },
    "checkver": {
      "description": "Version discovery (GitHub Releases supported by excavator)",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "github": { "type": "string", "description": "owner/repo" }
          }
        }
      ]
    },
    "autoupdate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "architecture": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "description": "Template with $version" },
              "hash": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Relative path inside a local bucket checkout"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "extension" } } },
      "then": { "required": ["api"] }
    }
  ]
}
